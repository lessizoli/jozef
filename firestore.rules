rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active != false;
    }

    function superAdmin() {
      return activeUser() && profile().role == 'superadmin';
    }

    function belongsTo(companyId) {
      return activeUser()
        && (superAdmin() || profile().companyId == companyId);
    }

    function companyAdmin(companyId) {
      return belongsTo(companyId)
        && (superAdmin() || profile().role in ['company_admin', 'admin']);
    }

    function defaultPermission(permission) {
      return profile().role == 'project_manager'
        && permission in ['createProjects', 'editProjects', 'manageDocuments', 'manageTeams']
        || profile().role in ['surveyor', 'installer'] && permission == 'manageDocuments';
    }

    function hasPermission(companyId, permission) {
      return companyAdmin(companyId)
        || belongsTo(companyId) && (
          exists(/databases/$(database)/documents/companies/$(companyId)/settings/permissions)
            ? get(/databases/$(database)/documents/companies/$(companyId)/settings/permissions).data.roles[profile().role][permission] == true
            : defaultPermission(permission)
        );
    }

    match /users/{userId} {
      allow read: if activeUser()
        && (superAdmin() || request.auth.uid == userId);

      allow update: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      allow create, delete: if superAdmin();
    }

    match /companies/{companyId} {
      allow read: if belongsTo(companyId);
      allow create, update, delete: if companyAdmin(companyId);

      match /projects/{projectId} {
        allow read: if belongsTo(companyId);
        allow create: if hasPermission(companyId, 'createProjects');
        allow update: if hasPermission(companyId, 'editProjects');
        allow delete: if companyAdmin(companyId);
      }

      match /{module}/{documentId} {
        allow read, create, update, delete: if belongsTo(companyId)
          && module in [
            'events',
            'surveys',
            'constructions',
            'executions',
            'quotes',
            'contracts',
            'finances',
            'files'
          ];
      }

      match /projects/{projectId}/attachments/{attachmentId} {
        allow read: if belongsTo(companyId);

        allow create: if hasPermission(companyId, 'manageDocuments')
          && request.resource.data.type in ['note', 'image', 'document', 'video', 'audio']
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if false;
        allow delete: if hasPermission(companyId, 'manageDocuments');
      }

      match /projects/{projectId}/constructionEntries/{entryId} {
        allow read: if belongsTo(companyId);
        allow create: if belongsTo(companyId)
          && request.resource.data.type in ['log', 'photo']
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /{adminSection}/{documentId} {
        allow read: if belongsTo(companyId)
          && adminSection in ['members', 'teams', 'settings', 'invites'];

        allow create, update, delete: if (
          adminSection == 'teams' && hasPermission(companyId, 'manageTeams')
          || adminSection in ['members', 'invites'] && hasPermission(companyId, 'manageMembers')
          || adminSection == 'settings' && companyAdmin(companyId)
        );
      }

      match /settings/permissions {
        allow read: if belongsTo(companyId);
        allow create, update: if companyAdmin(companyId);
        allow delete: if false;
      }

      match /activityLog/{logId} {
        allow read: if belongsTo(companyId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
