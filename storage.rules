rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function belongsTo(companyId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().active != false
        && (
          profile().role == 'superadmin'
          || profile().companyId == companyId
        );
    }

    function companyAdmin(companyId) {
      return belongsTo(companyId)
        && profile().role in ['superadmin', 'company_admin', 'admin'];
    }

    function canManageDocuments(companyId) {
      return companyAdmin(companyId)
        || belongsTo(companyId) && (
          firestore.exists(/databases/(default)/documents/companies/$(companyId)/settings/permissions)
            ? firestore.get(/databases/(default)/documents/companies/$(companyId)/settings/permissions).data.roles[profile().role].manageDocuments == true
            : profile().role in ['project_manager', 'surveyor', 'installer']
        );
    }

    function canManageFinance(companyId) {
      return companyAdmin(companyId)
        || belongsTo(companyId) && (
          firestore.exists(/databases/(default)/documents/companies/$(companyId)/settings/permissions)
            ? firestore.get(/databases/(default)/documents/companies/$(companyId)/settings/permissions).data.roles[profile().role].get('manageFinance', profile().role in ['project_manager', 'finance']) == true
            : profile().role in ['project_manager', 'finance']
        );
    }

    match /companies/{companyId}/projects/{projectId}/images/{fileName} {
      allow read: if belongsTo(companyId);

      allow create: if canManageDocuments(companyId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update: if false;
      allow delete: if canManageDocuments(companyId);
    }

    match /companies/{companyId}/projects/{projectId}/signed-contracts/{fileName} {
      allow read: if false;

      allow create: if canManageDocuments(companyId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png'
        ];

      allow update, delete: if false;
    }

    match /companies/{companyId}/projects/{projectId}/construction/{fileName} {
      allow read: if belongsTo(companyId);
      allow create: if belongsTo(companyId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /companies/{companyId}/projects/{projectId}/finance/{fileName} {
      allow read: if canManageFinance(companyId);
      allow create: if canManageFinance(companyId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/xml',
          'text/xml',
          'image/jpeg',
          'image/png'
        ];
      allow update, delete: if false;
    }

    match /companies/{companyId}/projects/{projectId}/documents/{fileName} {
      allow read: if belongsTo(companyId);
      allow create: if canManageDocuments(companyId)
        && request.resource.size < 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if canManageDocuments(companyId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
